# Copy to .env and adjust. The DuckDB path is shared by the ingestion step and dbt.
DUCKDB_PATH=netflix.duckdb
SOURCE_CSV=data/netflix_titles.csv

# Engine selection for the ingestion script: duckdb (default) or postgres
TARGET=duckdb

# Only needed when TARGET=postgres (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=netflix
POSTGRES_PASSWORD=netflix
POSTGRES_DB=netflix
POSTGRES_URL=postgresql+psycopg2://netflix:netflix@localhost:5432/netflix
